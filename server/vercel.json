{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/business/process-queue",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "server.js": {
      "maxDuration": 60
    }
  }
}
