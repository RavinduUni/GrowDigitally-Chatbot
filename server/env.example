PORT=3000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/database

# OpenAI — required for direct AI integration (replaces n8n chat path)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# n8n — still used for website scraping/training only
N8N_TRAIN_WEBHOOK=https://n8n.example.com/webhook/train-id
N8N_HOST=https://n8n.example.com
# Shared secret between n8n and this server for the /kb-status callback
N8N_CALLBACK_SECRET=change-me-to-a-random-string
# Vercel automatically sets CRON_SECRET — add it here for local testing only
CRON_SECRET=vercel-sets-this-automatically

# Widget
WIDGET_URL=https://your-vercel-app.vercel.app/widget.js
WIDGET_ORIGIN=https://your-vercel-app.vercel.app
